{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "vite.config.mts",
    "vite.main.config.mts",
    "vitest.config.mts",
    "src/main/**/*",
    "src/preload/index.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./.cache/tsconfig.node.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  }
}
