{
  "name": "@lnans/orgit",
  "version": "1.0.0",
  "main": "./out/main/index.js",
  "repository": "git@github.com:lnans/orgit.git",
  "author": "Nans Laupretre <nans.laupretre@gmail.com>",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "description": "A desktop control center for Git workspaces — one place to see your repositories, linked worktrees, and changes, with integrated terminals built in.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "typecheck": "tsc -b --noEmit",
    "fmt": "biome check --write .",
    "test": "vitest",
    "test:cc": "vitest --coverage",
    "validate": "yarn typecheck && yarn fmt",
    "build": "yarn typecheck && vite build && vite build -c vite.main.config.mts",
    "build:unpack": "yarn build && electron-builder --dir",
    "build:mac": "yarn build && electron-builder --mac",
    "build:win": "yarn build && electron-builder --win",
    "build:linux": "yarn build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@biomejs/biome": "^2.6.3",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^6.0.0",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.9.3",
    "electron-builder": "26.18.0",
    "i18next": "^26.5.11",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
